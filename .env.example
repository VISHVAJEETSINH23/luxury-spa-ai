# Copy to .env.local (and to your host's environment settings). Never commit real values.
# Only NEXT_PUBLIC_* values reach the browser; everything else stays on the server.

# --- Site address ----------------------------------------------------------
# The real domain once bought (no trailing slash). Used for Google/sitemap and
# the "view or cancel" link in WhatsApp messages.
NEXT_PUBLIC_SITE_URL=https://alexa-spa.vercel.app

# --- Database (Supabase, Mumbai) -------------------------------------------
# Dashboard → Project Settings → API Keys → "Secret keys". Server only.
SUPABASE_URL=https://flrnlbmbijnkzvloqbpt.supabase.co
SUPABASE_SECRET_KEY=

# --- Owner login -----------------------------------------------------------
# Run `npm run hash-password` and paste both lines it prints.
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# --- Razorpay, one account per branch --------------------------------------
# Dashboard → Account & Settings → API Keys. Use rzp_test_ keys until launch.
# Webhook secret: Dashboard → Webhooks → Add →
#   URL  https://<your-domain>/api/webhooks/razorpay/sangli   (or /karad)
#   Events: payment.captured, payment.failed, refund.processed
# Leave a branch blank and its "Pay online" option is simply switched off.
RAZORPAY_SANGLI_KEY_ID=
RAZORPAY_SANGLI_KEY_SECRET=
RAZORPAY_SANGLI_WEBHOOK_SECRET=

RAZORPAY_KARAD_KEY_ID=
RAZORPAY_KARAD_KEY_SECRET=
RAZORPAY_KARAD_WEBHOOK_SECRET=

# --- AI chatbot (Google AI Studio) -----------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Site-wide cap on Gemini calls per day; past it the chatbot answers from its
# built-in replies until tomorrow. Also set a budget alert in Google Cloud.
GEMINI_DAILY_LIMIT=1500

# --- Shared rate limits, logout revocation, chatbot cache (Upstash Redis) --
# upstash.com → Create database (region: ap-south-1 Mumbai) → REST API.
# Optional: without these each server instance counts on its own.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Error tracking (Sentry) -----------------------------------------------
# sentry.io → Create project → Next.js → copy the DSN. The DSN is not a
# secret (browsers need it), hence the NEXT_PUBLIC_ name. Off when blank.
NEXT_PUBLIC_SENTRY_DSN=
# Optional, for readable stack traces: Settings → Auth Tokens.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Scheduled jobs --------------------------------------------------------
# Any long random string. Vercel Cron sends it to /api/cron/daily.
CRON_SECRET=

